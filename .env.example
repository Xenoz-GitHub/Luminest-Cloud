# Copy this file to .env.local and replace every placeholder with your own values.
# Never commit real secrets.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider — free tiers, all OpenAI-compatible
# Choose: gemini | groq | openrouter | mistral | cerebras | openai-compatible
# Gemini key:    https://aistudio.google.com/app/apikey
# Groq key:      https://console.groq.com/keys
# OpenRouter:    https://openrouter.ai/settings/keys  (use a model ending in :free)
# Mistral:       https://console.mistral.ai/api-keys
# Cerebras:      https://cloud.cerebras.ai/
#
# AI_API_KEY accepts one key or a comma-separated list. LumiNest tries each
# key in order until one succeeds. To add more keys later WITHOUT editing this
# value, create separate variables AI_API_KEY_1, AI_API_KEY_2, AI_API_KEY_3, ...
# (each with a single key). They are merged after AI_API_KEY, in numeric order,
# so you can keep adding keys in Vercel one at a time. The same _<n> pattern
# works for provider pools (e.g. AI_API_KEY_GEMINI_1, AI_API_KEY_GEMINI_2).
# All keys must belong to the provider selected by AI_PROVIDER (for AI_API_KEY).
AI_PROVIDER=gemini
AI_API_KEY=your-free-api-key,another-free-api-key
# If a provider retires a model (404 "model not found"), set the current one:
# AI_MODEL_GEMINI=gemini-3.8-flash

# Leave empty to use the provider preset's default model.
# For openrouter, try: meta-llama/llama-3.3-70b-instruct:free
AI_MODEL=

# Only required for custom/openai-compatible endpoints.
AI_BASE_URL=

# Optional cross-provider fallback pools. The primary provider above is tried
# first, then these pools in preset order (gemini, groq, openrouter, mistral,
# cerebras, openai-compatible). Each accepts a comma-separated key list.
# AI_API_KEY_GEMINI=your-gemini-key-one,your-gemini-key-two
# AI_API_KEY_GROQ=your-groq-key-one,your-groq-key-two
# Per-provider overrides, if needed:
# AI_MODEL_GEMINI=
# AI_BASE_URL_GEMINI=

# ImageKit — private storage for plain images (png, jpg, webp, gif).
# Documents keep using Supabase storage. Leave these empty to store images in
# Supabase instead. Get them from ImageKit Dashboard → Developer Options.
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxx=
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxx=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Share links: long random string used to sign share tokens.
SHARE_TOKEN_SECRET=replace-with-a-long-random-string

# Public application URL (used in share links and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Operator panel (/blank-page)
# ---------------------------------------------------------------------------
# ADMIN_PIN_HASH is the scrypt hash of the operator PIN, in the form
#   scrypt:<saltHex>:<hashHex>
# Generate one with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('scrypt:'+s+':'+c.scryptSync('YOUR_PIN',s,64).toString('hex'))"
# The plaintext PIN is never stored in this file or in the repository.
ADMIN_PIN_HASH=

# Secret used to sign admin session cookies. Any long random string.
# Falls back to the Supabase service-role key when omitted.
ADMIN_SESSION_SECRET=
